# NOTE: this repository is public. There is deliberately no ignore rule for
# controlled material here — controlled work lives in a separate repository
# (`aether-gambit`), not in an ignored subdirectory of this one. An ignored
# directory is one `git add -f` away from being published; a separate
# repository is not. Do not reintroduce a `controlled/` rule.
#
# The one-way dependency is enforced by `tools/check_boundary.py`.

.kopiaignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

datasets/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Results are regenerated by `python -m aether.verification`
results/

# In Progress, Check Back Soon
manuscripts/references/
manuscripts/legacy/
manuscripts/notes.md
# Dependent on the results of previous papers
manuscripts/paper4/
manuscripts/paper5/

# LaTeX build artifacts. Each paper's latexmkrc sends every intermediate to
# its own build/ directory and writes only main.pdf beside the source, so one
# rule covers all three papers.
manuscripts/**/build/
# The editor passes -synctex=1, and the .synctex.gz has to sit beside the
# PDF rather than in build/ for the viewer's inverse search to resolve.
manuscripts/**/*.synctex.gz
