@article{putinar1993positive,
  author  = {Putinar, Mihai},
  title   = {Positive Polynomials on Compact Semi-Algebraic Sets},
  journal = {Indiana University Mathematics Journal},
  volume  = {42},
  number  = {3},
  pages   = {969--984},
  year    = {1993},
  note    = {The copy in references/ is a page scan with no text layer; page
             and theorem numbers below were read off the page images},
  annote  = {READ THIS FOR Lemma 4.1 p981, NOT FOR THE FOLKLORE ARCHIMEDEAN CONDITION.
             The lemma states that every positive polynomial on compact K lies
             in the additive cone Sigma^2 + p_1 Sigma^2 + ... + p_m Sigma^2 IF
             AND ONLY IF that cone contains some polynomial P whose
             non-negativity set P^{-1}[0,infty) is compact. That is strictly
             weaker than the usual "N - |x|^2 belongs to the quadratic module"
             gloss, and weaker than requiring a ball among the DEFINING
             polynomials (the form henrion2014convex Assumption 3 p304 and
             magron2015semidefinite Assumption 2.1 p2146 both use). For the
             entry corridor this matters: Paper 1 Section 2.4 does not owe a
             ball constraint, only SOME element of the quadratic module with
             compact non-negativity set, which an energy or total-enthalpy
             bound supplies directly. Thm 1.4 p972 is the paper's own headline
             and its hypothesis is likewise concrete rather than folkloric: the
             p_i have even degree and their top-degree homogeneous parts have no
             common real zero but the origin. Thm 1.1 p971 the rational-function
             Positivstellensatz for comparison; Thm 1.2 p971 Schmuedgen's
             preordering result; Thm 1.3 p972 the intermediate form, with the
             residual term q Sigma_0^2 the paper cannot yet remove.
             COUNT THE TERMS, they are the SDP block count: p970 and again
             p980 contrast 2^m + 1 products in the preordering
             (schmudgen1991kmoment) against m + 1 in the quadratic module here,
             and Thm 3.3 p980 gives m + 2 positivity conditions for the moment
             form. With m constraint polynomials in the corridor description
             that is the difference between an intractable and a merely large
             program.},
}

@article{schmudgen1991kmoment,
  author  = {Schm{\"u}dgen, Konrad},
  title   = {The {K}-Moment Problem for Compact Semi-Algebraic Sets},
  journal = {Mathematische Annalen},
  volume  = {289},
  pages   = {203--206},
  year    = {1991},
  doi     = {10.1007/BF01446568},
  note    = {Received 14 May 1990. Four pages},
  annote  = {The preordering result, and short enough to read in full. Thm 1 p203 a
             sequence is a K_R-moment sequence exactly when s and every
             (r_{j_1} ... r_{j_k})(E)s are positive definite --- one condition
             per SUBSET of the defining polynomials, hence 2^m of them.
             Cor 3 p205 is the Positivstellensatz that follows: p positive on
             K_R implies p is in the preordering. Cor 2 p205 the weaker closure
             statement. The proof (pp204-205) is by Hilbert-space methods on
             the GNS space of s, and turns on the multiplication operators being
             bounded, which is where compactness enters --- worth seeing, since
             it is the same mechanism as Putinar's compact-sublevel-set
             hypothesis. Cite alongside putinar1993positive whenever the
             2^m-versus-(m+1) cost of the two certificates is at issue.},
}

