% ------------------------------------------------------- entry flight mechanics
%
% ROUND 0, the prior-art gate: is skeleton-plus-bubbles already here, in
% non-measure-theoretic form? The short answer these entries support is
% YES for the DECOMPOSITION and NO for the BOUND. The classical literature
% has a unified equation with named distinguished limits (Chapman), a
% two-region matched-asymptotic composite solution for skip (Shi et al.,
% Kuo), and a convergence analysis for the glide skeleton (Lu). None of it
% produces a set, an outer approximation, or a certificate -- every result
% is a single approximate TRAJECTORY, validated by comparison against
% numerical integration. Write the contribution against that line.

@techreport{chapman1959approximate,
  author      = {Chapman, Dean R.},
  title       = {An Approximate Analytical Method for Studying Entry into
