@article{lasserre2001global,
  author  = {Lasserre, Jean-Bernard},
  title   = {Global Optimization with Polynomials and the Problem of Moments},
  journal = {SIAM Journal on Optimization},
  volume  = {11},
  number  = {3},
  pages   = {796--817},
  year    = {2001},
  doi     = {10.1137/S1052623400366802},
  note    = {Received 28 January 2000; accepted 28 August 2000; published
             electronically 19 January 2001},
  annote  = {The hierarchy in its original form. Prop 2.1 p799 the polynomial program
             and its measure relaxation are equivalent, and a global minimizer
             gives a Dirac optimum --- the one-line ancestor of the whole
             occupation-measure argument. Thm 3.2 p801 and Cor 3.3 p803 the
             unconstrained case via SOS. Thm 3.4 p805 convergence when a
             minimizer is known to satisfy a norm bound. THE ENTRY POINT FOR
             THE COMPACTNESS QUESTION IS Assumption 4.1 p809: not a ball
             constraint but the existence of a polynomial u, itself in the
             quadratic module generated by the g_i, with {u >= 0} compact.
             Lasserre notes p809 that this is an IF AND ONLY IF condition for
             the representation (4.3), and attributes it to Putinar's Lemma 4.1
             --- see putinar1993positive, where the precise statement is. Thm 4.2
             p810 convergence of the LMI hierarchy on K under that assumption.
             Prop 5.1 p814 and Thm 5.2 p815 the convex-quadratic case, where the
             first relaxation is already exact.},
}

